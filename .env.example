# Usado só pelo docker-compose.yml (deploy no servidor).
# Copie para .env ao lado, preencha e proteja: chmod 600 .env

APP_DOMAIN=bolaalta.fidosdoor.com.br
APP_TIMEZONE=America/Sao_Paulo

# Mongo compartilhado do servidor (container `mongo` na rede `data`)
MONGO_URI=mongodb://mongo:27017/bola-alta

# Segredo da sessão — gere com: openssl rand -hex 32
JWT_SECRET=

# Push do PWA — gere com: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
