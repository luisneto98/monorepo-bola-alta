{
  "name": "monorepo-bola-alta",
  "version": "1.0.0",
  "private": true,
  "description": "Bola Alta Comunidade - organização de peladas de vôlei",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev -w @bola-alta/api",
    "dev:web": "npm run dev -w @bola-alta/web",
    "build": "npm run build -w @bola-alta/api && npm run build -w @bola-alta/web",
    "db:up": "docker compose -f docker-compose.dev.yml up -d mongo",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "seed": "npm run seed -w @bola-alta/api",
    "vapid": "npm run vapid -w @bola-alta/api",
    "lint": "npm run lint -w @bola-alta/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
