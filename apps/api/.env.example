# Banco
MONGO_URI=mongodb://localhost:27019/bola-alta

# API
PORT=3334
NODE_ENV=development
APP_TIMEZONE=America/Sao_Paulo

# URL pública do site (usada no link do convite do WhatsApp)
APP_URL=http://localhost:3010

# Origens liberadas no CORS (só importa em dev; em prod tudo roda no mesmo domínio)
CORS_ORIGINS=http://localhost:3010

# Sessão
JWT_SECRET=troque-isso-por-algo-aleatorio
JWT_EXPIRES_IN=30d

# Push (PWA) — gere com: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Seed
SEED_ADMIN_NAME=Luis
SEED_ADMIN_EMAIL=admin@bolaalta.com
SEED_ADMIN_PASSWORD=bolaalta123
